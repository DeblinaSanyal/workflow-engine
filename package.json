{
  "name": "workflow-automation-platform",
  "version": "1.0.0",
  "description": "Scalable workflow automation platform with visual editor",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@workflow/backend",
    "dev:frontend": "npm run dev --workspace=@workflow/frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
